# Claude Code configuration and memory
.claude/

# Dependencies
node_modules/

# Vite build output, generated by `npm run build` (also run on every Vercel
# deploy via vercel.json). A build artifact, not source.
dist/

# Tailwind CLI build output, generated by `npm run build:css` (also run on
# every Vercel deploy). Run `npm install && npm run build:css` once locally
# before opening index.html directly.
style.compiled.css

# Environment files and secrets: never commit real values
.env
.env.*
*.env
.env.local
.env.*.local
.env.example

# Keys, certificates and credentials
*.pem
*.key
*.p12
*.pfx
*.crt
id_rsa*
credentials*.json
service-account*.json
secrets/

# Vercel local project link
.vercel/

# Receipt-quality harness output (CSV files derived from receipt photos,
# which are never stored in the repository)
scripts/harness-output/

# Local databases, dumps and backups
*.sqlite
*.sqlite3
*.db
*.dump
*.bak

# Private notes archive and scratch files
dev-notes-archive/
scratch/
tmp/
*.tmp

# Logs and test output
*.log
npm-debug.log*
coverage/

# OS/editor cruft
.DS_Store
Thumbs.db
.vscode/
.idea/

# Local build notes
README.md

# Impeccable design skill: machine-local files that must not be committed
.impeccable/config.local.json
.impeccable/hook.cache.json
.impeccable/*.png
.impeccable/live/server.json
.impeccable/live/sessions/
.impeccable/live/previews/
