# Claude Code config/memory — must never be pushed (Paeveul standing rule, claude_gitignore)
.claude/

# Dependencies
node_modules/

# Vite build output — generated by `npm run build` (also runs automatically
# on every Vercel deploy via vercel.json's buildCommand). Not committed: it's
# a build artifact, not source.
dist/

# Tailwind CLI build output — generated by `npm run build:css` (also runs
# automatically on every Vercel deploy via vercel.json's buildCommand).
# Not committed: it's a build artifact, not source. Run the build locally
# once (npm install && npm run build:css) before opening index.html directly.
style.compiled.css

# Environment secrets — never commit real values
.env
.env.local
.env.*.local
.env.example

# Vercel
.vercel/

# Item 17 Step 3 (bilang-mvp1-implementation-plans.md §17.6) — the receipt-
# quality fixture harness's CSV output. Never committed: fixture photos
# themselves already live outside the repo per Bilang's privacy posture (no
# receipt images persisted, ever), and these CSVs are derived from them.
scripts/harness-output/

# OS/editor cruft
.DS_Store
Thumbs.db

# Internal build notes — not for GitHub
README.md

# Impeccable design skill — ephemeral/machine-local files (config.json, design.json,
# critique/ are tracked in git per Impeccable's own recommendation; these are not)
.impeccable/config.local.json
.impeccable/hook.cache.json
.impeccable/*.png
.impeccable/live/server.json
.impeccable/live/sessions/
.impeccable/live/previews/
