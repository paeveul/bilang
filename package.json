{
  "name": "bilang",
  "private": true,
  "version": "0.1.0",
  "description": "Paeveul Bilang — MVP-1: free, peer-to-peer, photo-to-split bill splitting for Malaysian diners.",
  "engines": {
    "node": "20.19.x || >=22.12.0"
  },
  "scripts": {
    "build:css": "tailwindcss -i ./input.css -o ./style.compiled.css --minify",
    "watch:css": "tailwindcss -i ./input.css -o ./style.compiled.css --watch",
    "build": "npm run build:css && vite build",
    "dev": "vite",
    "preview": "vite preview",
    "test": "node --test js/totals.test.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.0",
    "@supabase/supabase-js": "^2.45.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^3.4.19",
    "vite": "^8.3.0"
  }
}
